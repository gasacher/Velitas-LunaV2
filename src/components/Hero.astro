---
import Logo from './Logo.astro';
import { images } from '../data/images';
import { route } from '../utils/path';

interface Props {
  image?: string;
  position?: string;
}

const { image = images.heroHome, position = 'center 35%' } = Astro.props;
---

<section class="hero" aria-label="Inicio">
  <div class="hero__bg">
    <img
      src={image}
      alt=""
      class="hero__image"
      style={`object-position: ${position}`}
      loading="eager"
      fetchpriority="high"
      width="1600"
      height="900"
    />
    <div class="hero__gradient"></div>
    <div class="hero__glow"></div>
  </div>

  <div class="hero__content container">
    <div class="hero__brand" data-reveal>
      <Logo variant="hero" />
    </div>
    <p class="hero__eyebrow" data-reveal data-reveal-delay="1">
      <span class="hero__moon" aria-hidden="true">☽</span>
      Velas artesanales · Buenos Aires
    </p>
    <h1 class="hero__title" data-reveal data-reveal-delay="2">
      Magia para<br /><em>empoderarte</em>
    </h1>
    <p class="hero__subtitle" data-reveal data-reveal-delay="3">
      Cada vela es una herramienta energética, creada a mano con intención para acompañarte en tus rituales.
    </p>
    <div class="hero__actions" data-reveal data-reveal-delay="4">
      <a href={route('/catalogo')} class="btn btn--primary">Catálogo</a>
    </div>
  </div>

  <a href="#experiencia" class="hero__scroll" aria-label="Descubrir más">
    <span class="hero__scroll-line"></span>
    <span class="hero__scroll-text">Descubrir</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding-top: var(--header-height);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: kenBurns 22s ease-in-out infinite alternate;
  }

  @keyframes kenBurns {
    from { transform: scale(1); }
    to { transform: scale(1.06); }
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(20, 16, 31, 0.55) 0%, rgba(20, 16, 31, 0.72) 55%, var(--color-bg) 100%),
      linear-gradient(to right, rgba(20, 16, 31, 0.55) 0%, transparent 55%);
  }

  .hero__glow {
    position: absolute;
    bottom: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 40%;
    background: radial-gradient(ellipse, rgba(200, 166, 245, 0.12), transparent 70%);
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 52rem;
    padding-bottom: 4rem;
  }

  .hero__brand {
    display: flex;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-lavender);
    margin-bottom: 1.5rem;
  }

  .hero__moon {
    font-size: 1.125rem;
    animation: moonPulse 4s ease-in-out infinite;
  }

  @keyframes moonPulse {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.1); }
  }

  .hero__title {
    font-size: clamp(2.75rem, 9vw, 5rem);
    font-weight: 500;
    color: var(--color-white);
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.45);
  }

  .hero__title em {
    font-style: italic;
    color: var(--color-accent-soft);
  }

  .hero__subtitle {
    font-size: clamp(1rem, 2.5vw, 1.125rem);
    color: rgba(243, 235, 248, 0.82);
    max-width: 30rem;
    margin: 0 auto 2.25rem;
    line-height: 1.75;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    justify-content: center;
  }

  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text-muted);
    z-index: 2;
    transition: color var(--transition);
  }

  .hero__scroll:hover {
    color: var(--color-lavender);
  }

  .hero__scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, var(--color-lavender), transparent);
    animation: scrollLine 2s ease-in-out infinite;
  }

  @keyframes scrollLine {
    0%, 100% { transform: scaleY(0.6); opacity: 0.5; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  .hero__scroll-text {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
</style>
