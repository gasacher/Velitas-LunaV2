---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Pillars from '../components/Pillars.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProductCard from '../components/ProductCard.astro';
import BentoGallery from '../components/BentoGallery.astro';
import CTABand from '../components/CTABand.astro';
import { route } from '../utils/path';
import {
  siteConfig,
  featuredProducts,
  ritualImages,
  instagramImages,
  intentions,
} from '../data/products';
---

<Layout title={siteConfig.name} currentPath="/">
  <Hero />

  <Pillars />

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Colección"
        title="Velas con propósito"
        subtitle="Una selección de nuestras piezas más pedidas. Cada vela lleva intención, aroma y cuidado artesanal."
      />
      <div class="grid-products">
        {featuredProducts.slice(0, 3).map((product, i) => (
          <div class="grid-products__item" data-reveal data-reveal-delay={((i % 4) + 1) as 1 | 2 | 3 | 4}>
            <ProductCard product={product} />
          </div>
        ))}
      </div>
      <div class="section-cta" data-reveal>
        <a href={route('/catalogo')} class="btn btn--primary">Ver catálogo completo</a>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        eyebrow="Rituales"
        title="Tu pausa, tu magia"
        subtitle="Dedicá unos minutos a encender tu intención. Un espacio para vos."
      />
      <BentoGallery images={ritualImages} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="Intenciones"
        title="Las más elegidas"
        subtitle="Elegí la energía que querés invitar a tu espacio hoy."
      />
      <div class="intentions">
        {
          intentions.map((item, i) => (
            <a
              href={`${route('/catalogo')}#${item.slug}`}
              class="intention-card"
              data-reveal
              data-reveal-delay={((i % 4) + 1) as 1 | 2 | 3 | 4}
            >
              <img src={item.image} alt={item.name} loading="lazy" style="object-position: center 25%" />
              <div class="intention-card__overlay">
                <span class="intention-card__name">{item.name}</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        eyebrow="Comunidad"
        title="Seguinos en Instagram"
        subtitle="Rituales, restocks y momentos mágicos del día a día."
      />
      <div class="section-cta section-cta--instagram" data-reveal>
        <a
          href={siteConfig.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn--instagram"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
            />
          </svg>
          @velitas.luna
        </a>
      </div>
      <BentoGallery images={instagramImages} link={siteConfig.instagram} layout="grid" />
    </div>
  </section>

  <CTABand />
</Layout>

<style>
  .section-cta {
    text-align: center;
    margin-top: 3rem;
  }

  .section-cta--instagram {
    margin-top: 0;
    margin-bottom: 2rem;
  }

  .intentions {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .intention-card {
    position: relative;
    aspect-ratio: 3/4;
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    border: 1px solid var(--color-border);
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .intention-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-glow);
  }

  .intention-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .intention-card:hover img {
    transform: scale(1.06);
  }

  .intention-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(20, 16, 31, 0.85) 0%, transparent 60%);
  }

  .intention-card__name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    color: var(--color-white);
  }

  @media (max-width: 900px) {
    .intentions {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .intentions {
      grid-template-columns: 1fr;
    }

    .intention-card {
      aspect-ratio: 16/10;
    }
  }
</style>
