---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/Banner.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactForm from '../components/ContactForm';
import { siteConfig } from '../data/products';
import { images } from '../data/images';
---

<Layout
  title="Contacto"
  description="Escribinos a Velitas de la Luna. Consultas sobre velas, pedidos y rituales."
  currentPath="/contacto"
>
  <Banner
    title="Contactanos"
    imageLeft={images.pages.contacto}
    imageRight={images.pages.contactoAlt}
    altLeft="Vela ritual"
    altRight="Ritual con velas"
    positionLeft="center 30%"
    positionRight="center 35%"
  />

  <section class="section">
    <div class="container">
      <div class="contact glass-panel" data-reveal>
        <SectionHeading
          eyebrow="Hablemos"
          title="¡Escribinos!"
          subtitle="Preguntas, pedidos o simplemente compartir tu experiencia mágica."
        />
        <ContactForm client:load />

        <div class="contact__alt">
          <span>Preferís Instagram?</span>
          <a
            href={siteConfig.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--secondary btn--sm"
          >
            @velitas.luna
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact {
    max-width: 640px;
    margin-inline: auto;
    padding: clamp(2rem, 5vw, 3rem);
  }

  .contact__alt {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .contact__alt span {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
